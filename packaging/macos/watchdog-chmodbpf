#!/bin/sh
# Grant the access_bpf group read access to the packet capture devices.
# Runs once at boot as root so that watchdog itself never needs privileges.
set -eu

group=access_bpf

if ! dscl . -read "/Groups/$group" >/dev/null 2>&1; then
    dseditgroup -o create "$group"
fi

chgrp "$group" /dev/bpf*
chmod g+rw /dev/bpf*
